# FoodBridge Environment Configuration Example
# Copy this file to .env or .env.local for local overrides

# Application
NEXT_PUBLIC_APP_NAME="FoodBridge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration
# Local SQLite development (default):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase / Neon / AWS RDS / local Postgres):
# DATABASE_URL="postgresql://foodbridge_user:your_secure_password@localhost:5432/foodbridge?schema=public"

# Authentication Security Secrets
# Change this in production: generate using `openssl rand -base64 32`
JWT_SECRET="foodbridge_secure_jwt_production_secret_key_change_me_32_chars"
SESSION_EXPIRY_DAYS="7"

# Optional External Services
# NEXT_PUBLIC_MAP_TILE_PROVIDER=""
# SMS_OTP_API_KEY=""

# CARTO Map Voyager Tiles
NEXT_PUBLIC_CARTO_API_KEY="cb1_4w8x_1_03fe88bb3dc2efff22ca2fba"
NEXT_PUBLIC_CARTO_TILE_URL="https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_4w8x_1_03fe88bb3dc2efff22ca2fba"
NEXT_PUBLIC_CARTO_VECTOR_URL="https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json?key=cb1_4w8x_1_03fe88bb3dc2efff22ca2fba"
